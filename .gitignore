# =============================================
# Lab-Mark WordPress Theme — .gitignore
# =============================================

# --- Папки ---
assets/images/

# --- Операционная система ---
.DS_Store
Thumbs.db
desktop.ini

# --- Редакторы и IDE ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.project
*.swp
*.swo
*~

# --- Логи и кэш ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Зависимости (если устанавливались через npm/composer) ---
node_modules/
vendor/

# --- Сборка и инструменты ---
dist/
build/
*.map

# --- Файлы переводов (генерируются) ---
languages/*.mo
languages/*.po

# --- Временные файлы ---
*.tmp
*.temp
.cache

# --- SASS/SCSS (если будут использоваться) ---
*.scss
*.sass

# --- Конфигурация среды ---
.env
.env.local
.env.*.local

# --- PHPUnit / Composer ---
.phpunit.result.cache
composer.lock

# --- Lock файлы (опционально) ---
package-lock.json
yarn.lock
